#!/bin/zsh
# Disposable apps for testing real deletions, with every file they create known in advance, so a
# deletion can be checked for anything left behind. Nothing here touches a real app.
#
#   Scripts/testapps plain      DeleteTest Plain: ~/Applications, running, a loaded launch agent
#   Scripts/testapps brew       DeleteTest Brew: a Homebrew cask from a local tap (no network),
#                               with a zap list and an rmdir vendor folder holding another product
#   Scripts/testapps package    DeleteTest Package: builds a .pkg (root-owned app, /Library files,
#                               a loaded launch daemon, a receipt); you install it with sudo
#   Scripts/testapps suite      DeleteTest Suite + DeleteTest Suite Helper: one Homebrew cask that
#                               installs two apps, which delete must remove together
#   Scripts/testapps shared     DeleteTest Shared + DeleteTest Shared Pro: two sandboxed apps sharing
#                               an app group, one identifier a prefix of the other's
#   Scripts/testapps all        plain, brew, suite and shared (package needs your password: separate)
#   Scripts/testapps check      what's left of each test app, and what must survive
#   Scripts/testapps untap      removes the local Homebrew tap once the Homebrew test apps are gone
#   Scripts/testapps clean      once every test app is deleted: the files delete rightly leaves (name
#                               matches, the other product's vendor folder) and the built test apps
set -euo pipefail

project=${0:A:h:h}
out=$project/.build/testapps
library=$HOME/Library
tap=deppes/delete-test
mkdir -p "$out"

# One small binary shared by every test app.
binary() {
    local source=$project/Scripts/TestApp/main.swift
    if [[ ! -x $out/DeleteTest || $source -nt $out/DeleteTest ]]; then
        swiftc -O -o "$out/DeleteTest" "$source"
    fi
}

# make_app <name> <bundle id> <folder>: an ad-hoc signed bundle.
make_app() {
    local name=$1 identifier=$2 app="$3/$1.app"
    binary
    rm -rf -- "$app"
    mkdir -p "$app/Contents/MacOS"
    cp "$out/DeleteTest" "$app/Contents/MacOS/DeleteTest"
    local info=$app/Contents/Info.plist
    plutil -create xml1 "$info"
    plutil -insert CFBundleIdentifier -string "$identifier" "$info"
    plutil -insert CFBundleName -string "$name" "$info"
    plutil -insert CFBundleExecutable -string DeleteTest "$info"
    plutil -insert CFBundlePackageType -string APPL "$info"
    plutil -insert CFBundleShortVersionString -string 1.0 "$info"
    plutil -insert LSUIElement -bool true "$info"
    if [[ -n ${4:-} ]]; then
        codesign -f -s - --entitlements "$4" "$app" 2>/dev/null
    else
        codesign -f -s - "$app" 2>/dev/null
    fi
}

# launch_item <plist> <label> <program>: runs the app with --agent, never at load.
launch_item() {
    local plist=$1
    plutil -create xml1 "$plist"
    plutil -insert Label -string "$2" "$plist"
    plutil -insert ProgramArguments -array "$plist"
    plutil -insert ProgramArguments.0 -string "$3" "$plist"
    plutil -insert ProgramArguments.1 -string --agent "$plist"
    plutil -insert RunAtLoad -bool false "$plist"
}

# tap_dir: the local tap's folder, made when missing.
tap_dir() {
    local repository=$(brew --repository)
    local dir=$repository/Library/Taps/${tap%%/*}/homebrew-${tap##*/}
    [[ -d $dir ]] || brew tap-new --no-git "$tap" >/dev/null
    mkdir -p "$dir/Casks"
    print -r -- "$dir"
}

# sandbox_entitlements <file> <app group>: sandboxed, with one app group.
sandbox_entitlements() {
    plutil -create xml1 "$1"
    plutil -insert com\\.apple\\.security\\.app-sandbox -bool true "$1"
    plutil -insert com\\.apple\\.security\\.application-groups -array "$1"
    plutil -insert com\\.apple\\.security\\.application-groups.0 -string "$2" "$1"
}

command=${1:-}
if [[ $command == all ]]; then
    for part in plain brew suite shared; do "$0" "$part"; done
    print "\nFor the package case (asks for your password):  Scripts/testapps package"
    exit 0
fi
case $command in
plain)
    app="$HOME/Applications/DeleteTest Plain.app"
    mkdir -p "$HOME/Applications" "$library/LaunchAgents"
    make_app "DeleteTest Plain" com.macdelete.test.plain "$HOME/Applications"
    agent=$library/LaunchAgents/com.macdelete.test.plain.agent.plist
    launchctl bootout "gui/$UID" "$agent" 2>/dev/null || true
    launch_item "$agent" com.macdelete.test.plain.agent "$app/Contents/MacOS/DeleteTest"
    launchctl bootstrap "gui/$UID" "$agent"
    # A command-line link into the bundle, and a QuickLook plug-in with its own sub-identifier.
    mkdir -p "$HOME/.local/bin" "$library/QuickLook"
    ln -sfn "$app/Contents/MacOS/DeleteTest" "$HOME/.local/bin/deletetest-plain"
    make_app "DeleteTest Preview" com.macdelete.test.plain.quicklook "$library/QuickLook"
    mv "$library/QuickLook/DeleteTest Preview.app" "$library/QuickLook/DeleteTest Preview.qlgenerator" 2>/dev/null || true
    # What an Electron app with Squirrel updates leaves, and XDG and shared folders by name.
    id=com.macdelete.test.plain
    mkdir -p "$library/Caches/$id.ShipIt" "$library/Saved Application State/$id.savedState" "$library/WebKit/$id" "$HOME/.local/share/deletetest-plain" "/Users/Shared/DeleteTest Plain"
    print "update" > "$library/Caches/$id.ShipIt/ShipItState.plist"
    print "cookies" > "$library/Cookies/$id.binarycookies"
    print "data" > "$HOME/.local/share/deletetest-plain/state"
    print "shared" > "/Users/Shared/DeleteTest Plain/shared.txt"
    open -g "$app"
    sleep 1
    print "Installed DeleteTest Plain (running, launch agent loaded). Try: delete --dry-run \"DeleteTest Plain\""
    ;;
brew)
    staging=$out/brew
    rm -rf -- "$staging"; mkdir -p "$staging"
    # Sandboxed, with an app group: macOS gives it a container, and the group comes from its signature.
    entitlements=$out/brew-entitlements.plist
    sandbox_entitlements "$entitlements" group.com.macdelete.test.brew
    make_app "DeleteTest Brew" com.macdelete.test.brew "$staging" "$entitlements"
    rm -f "$out/DeleteTestBrew.zip"
    ditto -c -k --keepParent "$staging/DeleteTest Brew.app" "$out/DeleteTestBrew.zip"
    tapdir=$(tap_dir)
    cat > "$tapdir/Casks/deletetest-brew.rb" <<EOF
cask "deletetest-brew" do
  version "1.0"
  sha256 :no_check

  url "file://$out/DeleteTestBrew.zip"
  name "DeleteTest Brew"
  desc "Disposable app for testing macdelete"
  homepage "https://example.invalid/"

  app "DeleteTest Brew.app"

  zap trash: [
        "~/Library/Application Support/DeleteTest Vendor/Brew",
        "~/Library/Preferences/com.macdelete.test.brew.plist",
      ],
      rmdir: "~/Library/Application Support/DeleteTest Vendor"
end
EOF
    HOMEBREW_NO_AUTO_UPDATE=1 HOMEBREW_NO_ENV_HINTS=1 brew install --cask "$tap/deletetest-brew"
    # The zap list's own folder, and another product's data in the shared vendor folder: the
    # rmdir must leave the vendor folder because of it.
    mkdir -p "$library/Group Containers/group.com.macdelete.test.brew"
    print "group data" > "$library/Group Containers/group.com.macdelete.test.brew/shared.txt"
    mkdir -p "$library/Application Support/DeleteTest Vendor/Brew" "$library/Application Support/DeleteTest Vendor/Other Product"
    print "state" > "$library/Application Support/DeleteTest Vendor/Brew/state.txt"
    print "must survive" > "$library/Application Support/DeleteTest Vendor/Other Product/keep.txt"
    # Homebrew quarantines what it installs, and Gatekeeper rejects an ad-hoc signed app; this
    # one was built here, so its quarantine flag is cleared.
    for app in "$HOME/Applications/DeleteTest Brew.app" "/Applications/DeleteTest Brew.app"; do
        # Homebrew re-signs what it installs, dropping the entitlements; this app is ours, so they're put back.
        [[ -d $app ]] && xattr -dr com.apple.quarantine "$app" && codesign -f -s - --entitlements "$entitlements" "$app" 2>/dev/null && open -g "$app"
    done
    sleep 1
    print "Installed DeleteTest Brew (running). Try: delete --dry-run \"DeleteTest Brew\""
    ;;
package)
    root=$out/pkgroot scripts=$out/pkgscripts
    rm -rf -- "$root" "$scripts"
    mkdir -p "$root/Applications" "$root/Library/Application Support/com.macdelete.test.pkg" "$root/Library/LaunchDaemons" "$scripts"
    make_app "DeleteTest Package" com.macdelete.test.pkg "$root/Applications"
    print "installed by the package" > "$root/Library/Application Support/com.macdelete.test.pkg/data.txt"
    launch_item "$root/Library/LaunchDaemons/com.macdelete.test.pkg.daemon.plist" com.macdelete.test.pkg.daemon "/Applications/DeleteTest Package.app/Contents/MacOS/DeleteTest"
    cat > "$scripts/postinstall" <<'EOF'
#!/bin/sh
launchctl bootstrap system /Library/LaunchDaemons/com.macdelete.test.pkg.daemon.plist 2>/dev/null || true
exit 0
EOF
    chmod +x "$scripts/postinstall"
    # Not relocatable: installed where the package says, never onto a copy found elsewhere.
    pkgbuild --analyze --root "$root" "$out/components.plist" >/dev/null
    plutil -replace 0.BundleIsRelocatable -bool false "$out/components.plist"
    pkgbuild --root "$root" --component-plist "$out/components.plist" --scripts "$scripts" --identifier com.macdelete.test.pkg --version 1.0 \
        --install-location / --ownership recommended "$out/built.pkg" >/dev/null 2>&1
    # pkgbuild stores extended attributes (macOS gives files made here a com.apple.provenance it
    # won't remove) as ._ files, which would be installed into /Library and /. The payload and its
    # file list are made again with cpio and mkbom, which write none, owned by root:wheel.
    expanded=$out/expanded
    rm -rf -- "$expanded" "$out/DeleteTestPackage.pkg"
    pkgutil --expand "$out/built.pkg" "$expanded"
    (cd "$root" && find . | cpio -o --format odc -R 0:0 2>/dev/null | gzip -c) > "$expanded/Payload"
    mkbom "$root" "$out/user.bom"
    # Everything is root:wheel, except folders that already exist on this Mac (/Applications is
    # root:admin 775), which keep exactly what they have: installing must never change them.
    lsbom "$out/user.bom" | while IFS=$'\t' read -r entry mode owner rest; do
        existing=/${entry#./}
        if [[ $entry != . && -d $existing ]]; then
            mode=$(stat -f %p "$existing") owner=$(stat -f %u/%g "$existing")
        else
            owner=0/0
        fi
        print -r -- "$entry"$'\t'"$mode"$'\t'"$owner"${rest:+$'\t'$rest}
    done > "$out/files.txt"
    mkbom -i "$out/files.txt" "$expanded/Bom"
    rm -f "$out/user.bom" "$out/files.txt"
    if lsbom -s "$expanded/Bom" | grep -q '\._'; then print -u2 "The file list still holds ._ files; not using it."; exit 1; fi
    count=$(find "$root" | wc -l | tr -d ' ')
    sed -i '' -E -e "s/numberOfFiles=\"[0-9]+\"/numberOfFiles=\"$count\"/" -e 's/overwrite-permissions="true"/overwrite-permissions="false"/' "$expanded/PackageInfo"
    pkgutil --flatten "$expanded" "$out/DeleteTestPackage.pkg"
    rm -rf -- "$expanded" "$out/built.pkg"
    print "Built $out/DeleteTestPackage.pkg. Install it yourself (needs your password):"
    print "  sudo installer -pkg ${(q)out}/DeleteTestPackage.pkg -target /"
    print "then launch it once:  open -g \"/Applications/DeleteTest Package.app\""
    ;;
suite)
    staging=$out/suite
    rm -rf -- "$staging"; mkdir -p "$staging"
    make_app "DeleteTest Suite" com.macdelete.test.suite "$staging"
    make_app "DeleteTest Suite Helper" com.macdelete.test.suitehelper "$staging"
    rm -f "$out/DeleteTestSuite.zip"
    (cd "$staging" && zip -qry "$out/DeleteTestSuite.zip" "DeleteTest Suite.app" "DeleteTest Suite Helper.app")
    tapdir=$(tap_dir)
    cat > "$tapdir/Casks/deletetest-suite.rb" <<EOF
cask "deletetest-suite" do
  version "1.0"
  sha256 :no_check

  url "file://$out/DeleteTestSuite.zip"
  name "DeleteTest Suite"
  desc "Disposable two-app cask for testing macdelete"
  homepage "https://example.invalid/"

  app "DeleteTest Suite.app"
  app "DeleteTest Suite Helper.app"

  zap trash: "~/Library/Preferences/com.macdelete.test.suite.plist"
end
EOF
    HOMEBREW_NO_AUTO_UPDATE=1 HOMEBREW_NO_ENV_HINTS=1 brew install --cask "$tap/deletetest-suite"
    for name in "DeleteTest Suite" "DeleteTest Suite Helper"; do
        for app in "$HOME/Applications/$name.app" "/Applications/$name.app"; do
            [[ -d $app ]] && xattr -dr com.apple.quarantine "$app" && codesign -f -s - "$app" 2>/dev/null && open -g "$app"
        done
    done
    sleep 1
    print "Installed DeleteTest Suite and its helper (both running). Try: delete --dry-run \"DeleteTest Suite Helper\" and \"DeleteTest Suite\""
    ;;
shared)
    # Two apps from one developer sharing an app group: the group's folder stays while either
    # app does. com.macdelete.test.shared is a prefix of com.macdelete.test.shared.pro, so
    # com.macdelete.test.shared.* items must not be taken from the Pro app either.
    mkdir -p "$HOME/Applications"
    entitlements=$out/shared-entitlements.plist
    sandbox_entitlements "$entitlements" group.com.macdelete.test.shared
    make_app "DeleteTest Shared" com.macdelete.test.shared "$HOME/Applications" "$entitlements"
    make_app "DeleteTest Shared Pro" com.macdelete.test.shared.pro "$HOME/Applications" "$entitlements"
    mkdir -p "$library/Group Containers/group.com.macdelete.test.shared"
    print "used by both apps" > "$library/Group Containers/group.com.macdelete.test.shared/shared.txt"
    open -g "$HOME/Applications/DeleteTest Shared.app" "$HOME/Applications/DeleteTest Shared Pro.app"
    sleep 1
    print "Installed DeleteTest Shared and DeleteTest Shared Pro (running). Try: delete --dry-run \"DeleteTest Shared\""
    ;;
check)
    cache=$(getconf DARWIN_USER_CACHE_DIR) temp=$(getconf DARWIN_USER_TEMP_DIR)
    report() {  # report <label> <path>
        [[ -e $2 || -L $2 ]] && print "  LEFT   $1: ${2/#$HOME/~}"
        return 0
    }
    for entry in "Plain:com.macdelete.test.plain" "Brew:com.macdelete.test.brew" "Package:com.macdelete.test.pkg" "Suite:com.macdelete.test.suite" \
                 "Suite Helper:com.macdelete.test.suitehelper" "Shared:com.macdelete.test.shared" "Shared Pro:com.macdelete.test.shared.pro"; do
        name="DeleteTest ${entry%%:*}" id=${entry#*:}
        print "$name ($id)"
        report app "$HOME/Applications/$name.app"; report app "/Applications/$name.app"
        for folder in "Application Support" Caches Logs HTTPStorages WebKit "Saved Application State"; do report data "$library/$folder/$id"; done
        report data "$library/Preferences/$id.plist"
        report data "$library/Saved Application State/$id.savedState"
        report temp "${cache%/}/$id"; report temp "${temp%/}/$id"
        [[ -e "$library/Application Support/$name" ]] && print "  NAME   ~/Library/Application Support/$name (name match: stays unless --include-name-matches)"
        case $id in
        *.plain)
            report "updater cache" "$library/Caches/$id.ShipIt"
            report "cookies" "$library/Cookies/$id.binarycookies"
            [[ -e "$HOME/.local/share/deletetest-plain" ]] && print "  NAME   ~/.local/share/deletetest-plain (name match)"
            [[ -e "/Users/Shared/DeleteTest Plain" ]] && print "  NAME   /Users/Shared/DeleteTest Plain (name match)"
            report "command link" "$HOME/.local/bin/deletetest-plain"
            report "QuickLook plug-in" "$library/QuickLook/DeleteTest Preview.qlgenerator"
            report "launch agent" "$library/LaunchAgents/$id.agent.plist"
            launchctl print "gui/$UID/$id.agent" >/dev/null 2>&1 && print "  LEFT   launch agent $id.agent is still loaded" ;;
        *.brew)
            report "container" "$library/Containers/$id"
            report "app group" "$library/Group Containers/group.com.macdelete.test.brew"
            report "Homebrew" "$(brew --prefix)/Caskroom/deletetest-brew"
            report "zap item" "$library/Application Support/DeleteTest Vendor/Brew"
            if [[ -e "$library/Application Support/DeleteTest Vendor/Other Product/keep.txt" ]]; then
                print "  OK     other product's data in the vendor folder survived"
            elif [[ -d "$library/Application Support/DeleteTest Vendor" ]]; then
                print "  WRONG  other product's data in the vendor folder is gone"
            fi ;;
        *.suite)
            report "Homebrew" "$(brew --prefix)/Caskroom/deletetest-suite" ;;
        *.shared)
            # The group stays while the Pro app is installed, and goes with the last of the two.
            if [[ -d "$HOME/Applications/DeleteTest Shared Pro.app" ]]; then
                [[ -d "$library/Group Containers/group.com.macdelete.test.shared" ]] && print "  OK     shared app group kept (DeleteTest Shared Pro still uses it)" \
                    || print "  WRONG  shared app group is gone while DeleteTest Shared Pro still uses it"
            else
                report "app group" "$library/Group Containers/group.com.macdelete.test.shared"
            fi
            report "container" "$library/Containers/$id" ;;
        *.shared.pro)
            report "container" "$library/Containers/$id" ;;
        *.pkg)
            report "package file" "/Library/Application Support/$id"
            report "launch daemon" "/Library/LaunchDaemons/$id.daemon.plist"
            # Only root may look into the system domain.
            if (( EUID == 0 )); then
                if launchctl print "system/$id.daemon" >/dev/null 2>&1; then print "  LEFT   launch daemon $id.daemon is still loaded"; fi
            else
                print "  ?      whether launch daemon $id.daemon is loaded: run with sudo to check"
            fi
            pkgutil --pkg-info "$id" >/dev/null 2>&1 && print "  LEFT   installer receipt $id" ;;
        esac
        if pgrep -f "/$name.app/Contents/MacOS/DeleteTest" >/dev/null; then print "  LEFT   still running"; fi
    done
    ;;
clean)
    for app in "$HOME"/Applications/DeleteTest*.app(N) /Applications/DeleteTest*.app(N); do
        print -u2 "${app:t:r} is still installed; delete it first (and run check)."; exit 1
    done
    # Only these fixed paths, which nothing but these scripts creates.
    for item in "$library/Application Support/DeleteTest "{Plain,Brew,Package,Suite,"Suite Helper",Shared,"Shared Pro",Vendor} \
                "$HOME/.local/share/deletetest-plain" "/Users/Shared/DeleteTest Plain" "$out"; do
        [[ -e $item ]] && rm -rf -- "$item" && print "Removed ${item/#$HOME/~}"
    done
    if pkgutil --pkg-info com.macdelete.test.pkg >/dev/null 2>&1; then print "DeleteTest Package's receipt is still there: delete \"DeleteTest Package\" removes it."; fi
    ;;
untap)
    for token in deletetest-brew deletetest-suite; do
        if brew list --cask $token >/dev/null 2>&1; then print -u2 "The $token cask is still installed; delete its app first."; exit 1; fi
    done
    brew untap "$tap" && print "Removed the $tap tap."
    ;;
*)
    print -u2 "usage: Scripts/testapps plain | brew | package | suite | shared | all | check | untap | clean"
    exit 2
    ;;
esac
