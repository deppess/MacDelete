#!/bin/zsh
# Runs every deterministic repository quality gate. This is the required check before a release.
set -euo pipefail

project=${0:A:h:h}
cd "$project"

swift test
.claude/hooks/test-guard-delete.sh
swift build -c release --product delete
swift test -c release
swift format lint --strict --recursive Sources Tests
zsh -n Scripts/quality Scripts/format Scripts/benchmark Scripts/sandbox Scripts/sandbox-all Scripts/testapps
git diff --check
